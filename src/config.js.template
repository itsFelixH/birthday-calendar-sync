// ─── Title templates ──────────────────────────────────────────────────────────
// Available placeholders:
//   {name}      — contact name
//   {age}       — age they're turning
//   {birthdate} — formatted birth date (e.g., 15.01.1990)
//   {city}      — contact's city
//   {email}     — contact's email address
//   {lifespan}  — "*1990 †2022" (memorial only, requires death date for full format)
// Summary title also supports:
//   {month}     — full month name
//   {year}      — year
//   {count}     — number of birthdays that month
const eventTitles = {
  birthday: '🎂 {name}\'s Birthday',
  milestone: '🎂🎉 {name} turns {age}! 🎉',
  recurring: '🎂 {name}\'s Birthday',
  memorial: '🕯️ {name}',
  summary: '🎉🎂 BIRTHDAYS 🎂🎉'
};

// ─── Description texts ────────────────────────────────────────────────────────
// Labels and section headers used in event descriptions.
// Set a header to '' to hide it (content still appears).
// birthdayWithAge/birthdayNoAge support:
