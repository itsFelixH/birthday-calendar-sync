// ═══════════════════════════════════════════════════════════════════════════════
// 1. REQUIRED — You must set this
// ═══════════════════════════════════════════════════════════════════════════════

// The Google Calendar where birthday events will be created.
// Find it in: Google Calendar → Settings → (your calendar) → "Integrate calendar" → Calendar ID
const calendarId = 'your-calendar-id@group.calendar.google.com';


// ═══════════════════════════════════════════════════════════════════════════════
// 2. FEATURES — What should the script do?
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Calendar events ──────────────────────────────────────────────────────────

// Create one all-day event per contact on their birthday.
const createIndividualBirthdayEvents = true;

// Create one event per month listing all birthdays that month.
const createBirthdaySummaryEvents = true;

// 'single' = one event per birthday per year.
// 'recurring' = one yearly recurring event per contact (no age in description).
// Leap year birthdays (Feb 29) always use single events regardless of this setting.
const eventRecurrence = 'single';

// ─── Email notifications ──────────────────────────────────────────────────────
// All emails are off by default. Enable the ones you want.

// Email report after each sync listing created/updated events.
const sendSyncReport = false;

// Monthly email listing next month's birthdays.
const sendMonthlySummaryEmail = false;

// Weekly email listing upcoming birthdays.
const sendWeeklyReminderEmail = false;

// ─── Contact filtering ────────────────────────────────────────────────────────

// Set useLabel to true and add label names to only sync specific contacts.
// When false, all contacts with birthdays are synced.
const useLabel = false;
const labelFilter = []; // e.g. ['Friends', 'Family']


// ═══════════════════════════════════════════════════════════════════════════════
// 3. LOCALE — Adjust for your language
// ═══════════════════════════════════════════════════════════════════════════════

// Month name abbreviations (used in event descriptions and formatting).
var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

// Full month names (used in summary headers and emails).
var monthNamesLong = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];


// ═══════════════════════════════════════════════════════════════════════════════
// 4. SCHEDULES — When should things run?
// ═══════════════════════════════════════════════════════════════════════════════
// Used by setupSchedules(). Run it once after deploying.
// Hours are approximate — Apps Script triggers fire within a ±1 hour window.
// Use ScriptApp.WeekDay values: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY

// Calendar sync: fetches contacts and creates/updates events.
const scheduleSyncDay = ScriptApp.WeekDay.MONDAY;
const scheduleSyncHour = 3; // ~3:00 AM

// Monthly summary email (only sent if sendMonthlySummaryEmail = true).
const scheduleMonthlySummaryDay = 28; // day of month (1-28)
const scheduleMonthlySummaryHour = 9; // ~9:00 AM

// Weekly reminder email (only sent if sendWeeklyReminderEmail = true).
const scheduleWeeklyReminderDay = ScriptApp.WeekDay.MONDAY;
const scheduleWeeklyReminderHour = 10; // ~10:00 AM


// ═══════════════════════════════════════════════════════════════════════════════
// 5. REMINDERS & TIMING — Fine-tune event behavior
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Calendar reminders ───────────────────────────────────────────────────────
// Method: 'popup', 'email', or 'none'

const individualReminderMethod = 'popup';
const individualReminderMinutes = 60 * 24; // 1 day before

const summaryReminderMethod = 'popup';
const summaryReminderMinutes = 5760; // 4 days before (4 × 24 × 60)

// ─── Lookahead ────────────────────────────────────────────────────────────────
// How many months ahead to create/update events.

const individualMonthsAhead = 12;
const summaryMonthsAhead = 6;

// ─── Weekly reminder settings ─────────────────────────────────────────────────

// How many days ahead to include in the weekly reminder email.
const reminderDaysBefore = 7;

// Day of the week to send the reminder (0=Sun, 1=Mon, ..., 6=Sat).
// Set to -1 to send every day the trigger runs.
const weeklyReminderDay = 1;

// ─── Summary event placement ──────────────────────────────────────────────────

// Day of the month for the summary calendar event (1-28).
const summaryEventDay = 1;


