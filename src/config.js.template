// 8. SPECIAL HANDLING
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Milestones ───────────────────────────────────────────────────────────────

// Use a special title (eventTitles.milestone) for round birthdays.
const highlightMilestones = true;
const milestoneAges = [18, 30, 40, 50, 60, 70, 75, 80, 90, 100];

// ─── Leap year ────────────────────────────────────────────────────────────────

// Where to place Feb 29 birthdays in non-leap years: 'feb28' or 'mar1'.
const leapYearHandling = 'feb28';

// ─── Deceased contacts ────────────────────────────────────────────────────────

// 'skip' = no events created (default).
// 'memorial' = memorial event with 🕯️ prefix and lifespan.
// 'normal' = treated like any other contact.
const deceasedHandling = 'skip';

// Google Contacts label that marks a contact as deceased.
const deceasedLabel = 'Deceased';

// Custom date field label in Google Contacts for the death date.
const deceasedDateLabel = 'Death date';


