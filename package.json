{
  "name": "birthday-calendar-sync",
  "version": "1.0.0",
  "description": "Google Apps Script for syncing birthdays from contacts to calendar",
  "main": "src/main.js",
  "scripts": {
    "test": "jest",
    "deploy": "pnpm test && pnpx clasp push"
  },
  "dependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.8"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test.js"
    ]
  }
}
